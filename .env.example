# Copy to .env (gitignored) and point at your own files. All optional — each command
# also takes the value as a flag. `bin/run` sources .env, so commands run bare.

# Expected-config for `preflight`; `ports` and `report` read it for
# monitor.physical_outputs. Start from config/example-preflight.json.
X32SCENE_CONFIG="./config/example-preflight.json"

# Console model for its main output jack count: `ports`, `report` and `preflight`
# (--regenerate writes it as monitor.physical_outputs). X32RACK or "X32 Rack".
# X32SCENE_CONSOLE="X32RACK"

# Stage sidecar — which jack, device and wearer each output feeds. Read by
# `preflight`, `ports` and `report`. Start from config/example-stage.json.
X32SCENE_STAGE="./config/example-stage.json"

# Directory of .scn files for `audit`, `history` and the round-trip test.
X32SCENE_CORPUS="$HOME/Music/Behringer/x32/Scenes"

# A scene the drift test regenerates a config from and compares to X32SCENE_CONFIG.
# X32SCENE_REGEN_SCENE="$HOME/Music/Behringer/x32/Scenes/current.scn"

# Console IP for `pull`, `live-diff`, `desk`, `meters` and `watch` (UDP 10023).
X32SCENE_IP="192.168.1.10"

# Seconds to wait for each path's reply on `pull`, `live-diff`, `desk` and `watch`. Default 0.5.
X32SCENE_TIMEOUT="0.5"

# A JSON-lines log of every invocation. Unset by default.
# LOG_FILE="./logs/x32scene.jsonl"
