# Copy to .env (gitignored) and point at your own files. All optional — each command
# also takes the value as a flag.

# Expected-config for `preflight`. Start from config/example-preflight.json.
X32SCENE_CONFIG="./config/example-preflight.json"

# Directory of .scn files for `audit`.
X32SCENE_CORPUS="$HOME/Music/Behringer/x32/Scenes"

# Console IP for `pull` / `live-diff`.
X32SCENE_IP="192.168.1.10"

# Seconds to wait for each path's reply on `pull` / `live-diff`. Default 0.5.
X32SCENE_TIMEOUT="0.5"
