#!/usr/bin/env bash
# bin/run — invoke a command via the x32scene venv.
#
#   bin/run pytest [args]     run the test suite in the venv
#   bin/run python [args]     one-off venv'd python
#   bin/run pip|ruff [args]   pip / ruff in the venv
#   bin/run pf-doctor [args]  pf-core runtime attestation (--release before a tag)
#   bin/run lint              ruff check + pf-core structural gate (300 soft / 500 hard)
#   bin/run setup             install editable + link pf-core docs
#   bin/run x32scene [args]   the CLI
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PY="$ROOT/.venv/bin/python"

# Local, uncommitted settings.
if [ -f "$ROOT/.env" ]; then set -a; . "$ROOT/.env"; set +a; fi

cmd="${1:-}"; shift || true
case "$cmd" in
  pytest|python|pip|ruff|pf-guards|pf-doctor|pf-setup)
    exec "$ROOT/.venv/bin/$cmd" "$@" ;;
  x32scene) exec "$PY" -m x32scene.cli "$@" ;;
  setup)
    [ -d "$ROOT/.venv" ] || python3.12 -m venv "$ROOT/.venv"
    "$PY" -m pip install -q --upgrade pip
    "$PY" -m pip install -q -e ".[dev]"
    mkdir -p docs
    ln -sfn "$("$PY" -c 'import pf_core, pathlib; print(pathlib.Path(pf_core.__file__).parent / "docs")')" \
       docs/pf-core 2>/dev/null || true
    echo "setup OK"
    ;;
  lint)
    "$ROOT/.venv/bin/ruff" check src tests
    "$PY" -m pf_core.guards          # roots come from .pf-guards.toml
    echo "lint OK"
    ;;
  ""|--help|-h) echo "usage: bin/run {setup|pytest|python|pip|ruff|lint|pf-doctor|x32scene} [args]" ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
