#!/usr/bin/env bash
# bin/run — invoke a command via the x32scene venv.
#
#   bin/run pytest [args]     run the test suite in the venv
#   bin/run python [args]     one-off venv'd python
#   bin/run pip|ruff [args]   pip / ruff in the venv
#   bin/run pw-doctor [args]  pw-foundation runtime attestation (--release before a tag)
#   bin/run lint              ruff check + pw-foundation structural gate (300 soft / 500 hard)
#   bin/run setup             install editable + pw-setup (docs link, rules)
#   bin/run x32scene [args]   the CLI
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PY="$ROOT/.venv/bin/python"

# Local, uncommitted settings.
if [ -f "$ROOT/.env" ]; then set -a; . "$ROOT/.env"; set +a; fi

cmd="${1:-}"; shift || true
case "$cmd" in
  pytest|python|pip|ruff|pw-guards|pw-doctor|pw-setup)
    exec "$ROOT/.venv/bin/$cmd" "$@" ;;
  x32scene) exec "$PY" -m x32scene.cli "$@" ;;
  setup)
    [ -d "$ROOT/.venv" ] || python3.12 -m venv "$ROOT/.venv"
    "$PY" -m pip install -q --upgrade pip
    "$PY" -m pip install -q -e ".[dev]"
    "$ROOT/.venv/bin/pw-setup"   # docs/pw-foundation link, starter rules, editor links, gate config
    echo "setup OK"
    ;;
  lint)
    "$ROOT/.venv/bin/ruff" check src tests
    "$PY" -m pw_foundation.guards          # roots come from .pw-guards.toml
    echo "lint OK"
    ;;
  ""|--help|-h) echo "usage: bin/run {setup|pytest|python|pip|ruff|lint|pw-doctor|x32scene} [args]" ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
